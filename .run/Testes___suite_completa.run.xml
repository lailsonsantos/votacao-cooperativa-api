<component name="ProjectRunConfigurationManager">
  <!--
    Suite completa: unitarios, integracao com PostgreSQL real via Testcontainers,
    gate de cobertura, verificacao de formatacao e analise estatica.

    Exige o Docker Desktop em execucao. E exatamente o mesmo comando que roda no
    CI — nao existe um comando especial de CI que passe onde o local falha.
  -->
  <configuration default="false" name="Testes - suite completa"
                 type="MavenRunConfiguration" factoryName="Maven" nameIsGenerated="false">
    <MavenSettings>
      <option name="myGeneralSettings"/>
      <option name="myRunnerSettings"/>
      <option name="myRunnerParameters">
        <MavenRunnerParameters>
          <option name="goals">
            <list>
              <option value="verify"/>
            </list>
          </option>
          <option name="workingDirPath" value="$PROJECT_DIR$"/>
        </MavenRunnerParameters>
      </option>
    </MavenSettings>
    <method v="2"/>
  </configuration>
</component>
