<component name="ProjectRunConfigurationManager">
  <!--
    Sobe a aplicacao contra o PostgreSQL do docker-compose, no perfil prod.

    Exige o banco no ar antes:  docker compose up banco

    Use quando quiser exercitar o caminho real de producao: Flyway sobre
    PostgreSQL e log estruturado em JSON.
  -->
  <configuration default="false" name="API - PostgreSQL do Docker"
                 type="SpringBootApplicationConfigurationType"
                 factoryName="Spring Boot" nameIsGenerated="false">
    <module name="votacao"/>
    <option name="SPRING_BOOT_MAIN_CLASS" value="br.com.cooperativa.votacao.VotacaoApplication"/>
    <option name="ACTIVE_PROFILES" value="prod"/>
    <envs>
      <env name="SPRING_DATASOURCE_URL" value="jdbc:postgresql://localhost:5432/votacao"/>
      <env name="SPRING_DATASOURCE_USERNAME" value="votacao"/>
      <env name="SPRING_DATASOURCE_PASSWORD" value="votacao"/>
      <env name="APP_USER_INFO_ENABLED" value="false"/>
    </envs>
    <method v="2">
      <option name="Make" enabled="true"/>
    </method>
  </configuration>
</component>
