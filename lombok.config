# Raiz da configuracao: impede que o Lombok procure arquivos em diretorios acima.
config.stopBubbling = true

# Marca o codigo gerado com @lombok.Generated. O JaCoCo reconhece essa anotacao e
# exclui getters, construtores e equals do calculo de cobertura — sem isso, o
# gate de 80% mediria codigo que ninguem escreveu e que nao pode conter bug.
lombok.addLombokGeneratedAnnotation = true

# O construtor gerado por @RequiredArgsConstructor precisa carregar as anotacoes
# de injecao declaradas nos campos; sem estas linhas, @Value e @Qualifier seriam
# perdidos na geracao e a injecao falharia em tempo de execucao.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
